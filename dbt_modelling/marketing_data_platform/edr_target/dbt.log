un_results", "schema": "staging"}, {"database": "marketing_dev", "identifier": "job_run_results", "schema": "staging"}, {"database": "marketing_dev", "identifier": "data_monitoring_metrics", "schema": "staging"}, {"database": "marketing_dev", "identifier": "alerts_dbt_source_freshness", "schema": "staging"}, {"database": "marketing_dev", "identifier": "metrics_anomaly_score", "schema": "staging"}, {"database": "marketing_dev", "identifier": "dbt_artifacts_hashes", "schema": "staging"}], "schema": "staging"}, "info": {"category": "", "code": "E014", "extra": {}, "invocation_id": "eeae0353-0417-4ca3-b149-a2e72ee00738", "level": "debug", "msg": "While listing relations in database=marketing_dev, schema=staging, found: dbt_seeds, snapshot_run_results, alerts_dbt_models, elementary_test_results, dbt_source_freshness_results, dbt_exposures, alerts_anomaly_detection, dbt_models, monitors_runs, alerts_schema_changes, dbt_columns, alerts_dbt_tests, dbt_invocations, schema_columns_snapshot, anomaly_threshold_sensitivity, dbt_tests, dbt_run_results, dbt_snapshots, dbt_metrics, test_result_rows, dbt_sources, metadata, model_run_results, job_run_results, data_monitoring_metrics, alerts_dbt_source_freshness, metrics_anomaly_score, dbt_artifacts_hashes", "name": "ListRelations", "pid": 35500, "thread": "MainThread", "ts": "2026-10-12T22:45:26.625803Z"}}
