{"data": {"msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.marketing_data_platform.fct_marketing_spend\", \"invocation_id\": \"a2401a3a-3efa-4838-9279-4ef72974f0e1\", \"name\": \"fct_marketing_spend\", \"schema\": \"staging_marts\", \"status\": \"success\", \"execution_time\": 10.9, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\nwith __dbt__cte__int_marketing_ads as (\\n\\n\\nSELECT\\n    date,\\n    platform,\\n    ad_id,\\n    account_id,\\n    campaign_id,\\n    ad_group_id,\\n    ad_name,\\n    ad_status,\\n    campaign_name,\\n    ad_group_name,\\n    currency,\\n    spend,\\n    impressions,\\n    clicks\\nFROM `marketing_dev`.`staging_staging`.`stg_facebook_ads`\\n\\nUNION ALL\\n\\nSELECT\\n    date,\\n    platform,\\n    ad_id,\\n    account_id,\\n    campaign_id,\\n    ad_group_id,\\n    ad_name,\\n    ad_status,\\n    campaign_name,\\n    ad_group_name,\\n    currency,\\n    spend,\\n    impressions,\\n    clicks\\nFROM `marketing_dev`.`staging_staging`.`stg_snapchat_ads`\\n) SELECT\\n    date,\\n    platform,\\n    campaign_id,\\n    campaign_name,\\n    ad_group_id,\\n    ad_group_name,\\n    ad_id,\\n    ad_name,\\n    ad_status,\\n    account_id,\\n    currency,\\n    spend,\\n    impressions,\\n    clicks,\\n    -- Business Metrics\\n    CASE WHEN impressions > 0 THEN CAST(clicks AS DOUBLE) / impressions ELSE 0 END AS ctr,\\n    CASE WHEN clicks > 0 THEN spend / clicks ELSE 0 END AS cpc,\\n    CASE WHEN impressions > 0 THEN (spend / impressions) * 1000 ELSE 0 END AS cpm\\nFROM __dbt__cte__int_marketing_ads\\n\\n\", \"generated_at\": \"2026-10-12 22:24:50\"}, {\"unique_id\": \"model.marketing_data_platform.stg_facebook_ads\", \"invocation_id\": \"a2401a3a-3efa-4838-9279-4ef72974f0e1\", \"name\": \"stg_facebook_ads\", \"schema\": \"staging_staging\", \"status\": \"success\", \"execution_time\": 5.7, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"\\n\\nSELECT\\n    s.ad_date AS date,\\n    'facebook' AS platform,\\n    CAST(s.ad_id AS STRING) AS ad_id,\\n    CAST(s.account_id AS STRING) AS account_id,\\n    CAST(a.campaign_id AS STRING) AS campaign_id,\\n    CAST(a.ad_group_id AS STRING) AS ad_group_id,\\n    a.ad_name,\\n    a.ad_status,\\n    c.campaign_name,\\n    ag.ad_group_name,\\n    ac.account_name,\\n    ac.ad_currency_code AS currency,\\n    s.ad_spend AS spend,\\n    COALESCE(s.ad_impressions, 0) AS impressions,\\n    COALESCE(s.ad_clicks, 0) AS clicks,\\n    CURRENT_TIMESTAMP() AS _loaded_at\\nFROM `marketing_dev`.`raw`.`facebook_ads_stats` s\\nLEFT JOIN `marketing_dev`.`raw`.`facebook_ad` a\\n    ON s.ad_id = a.ad_id\\nLEFT JOIN `marketing_dev`.`raw`.`facebook_campaign` c\\n    ON a.campaign_id = c.campaign_id\\nLEFT JOIN `marketing_dev`.`raw`.`facebook_adgroup` ag\\n    ON a.ad_group_id = ag.ad_group_id\\nLEFT JOIN `marketing_dev`.`raw`.`facebook_account` ac\\n    ON s.account_id = ac.account_id\", \"generated_at\": \"2026-10-12 22:24:50\"}, {\"unique_id\": \"model.marketing_data_platform.stg_snapchat_ads\", \"invocation_id\": \"a2401a3a-3efa-4838-9279-4ef72974f0e1\", \"name\": \"stg_snapchat_ads\", \"schema\": \"staging_staging\", \"status\": \"success\", \"execution_time\": 4.6, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"\\n\\nSELECT\\n    s.ad_date AS date,\\n    'snapchat' AS platform,\\n    CAST(s.ad_id AS STRING) AS ad_id,\\n    NULL AS account_id,\\n    CAST(c.campaign_id AS STRING) AS campaign_id,\\n    CAST(a.ad_group_id AS STRING) AS ad_group_id,\\n    a.ad_name,\\n    NULL AS ad_status,\\n    c.campaign_name,\\n    ag.ad_group_name,\\n    NULL AS account_name,\\n    s.ad_currency_code AS currency,\\n    s.ad_spend AS spend,\\n    COALESCE(s.ad_impressions, 0) AS impressions,\\n    COALESCE(s.ad_clicks, 0) AS clicks,\\n    CURRENT_TIMESTAMP() AS _loaded_at\\nFROM `marketing_dev`.`raw`.`snapchat_ads_stats` s\\nLEFT JOIN `marketing_dev`.`raw`.`snapchat_ad` a\\n    ON s.ad_id = a.ad_id\\nLEFT JOIN `marketing_dev`.`raw`.`snapchat_adgroup` ag\\n    ON a.ad_group_id = ag.ad_group_id\\nLEFT JOIN `marketing_dev`.`raw`.`snapchat_campaign` c\\n    ON ag.campaign_id = c.campaign_id\", \"generated_at\": \"2026-10-12 22:24:50\"}]--ELEMENTARY-MACRO-OUTPUT-END--"}, "info": {"category": "", "code": "I062", "extra": {}, "invocation_id": "f2663e0a-7259-4275-92bc-15f14cf060b0", "level": "info", "msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.marketing_data_platform.fct_marketing_spend\", \"invocation_id\": \"a2401a3a-3efa-4838-9279-4ef72974f0e1\", \"name\": \"fct_marketing_spend\", \"schema\": \"staging_marts\", \"status\": \"success\", \"execution_time\": 10.9, \"full_refresh\": false, \"materialization\": \"incremental\", \"compiled_code\": \"\\n\\nwith __dbt__cte__int_marketing_ads as (\\n\\n\\nSELECT\\n    date,\\n    platform,\\n    ad_id,\\n    account_id,\\n    campaign_id,\\n    ad_group_id,\\n    ad_name,\\n    ad_status,\\n    campaign_name,\\n    ad_group_name,\\n    currency,\\n    spend,\\n    impressions,\\n    clicks\\nFROM `marketing_dev`.`staging_staging`.`stg_facebook_ads`\\n\\nUNION ALL\\n\\nSELECT\\n    date,\\n    platform,\\n    ad_id,\\n    account_id,\\n    campaign_id,\\n    ad_group_id,\\n    ad_name,\\n    ad_status,\\n    campaign_name,\\n    ad_group_name,\\n    currency,\\n    spend,\\n    impressions,\\n    clicks\\nFROM `marketing_dev`.`staging_staging`.`stg_snapchat_ads`\\n) SELECT\\n    date,\\n    platform,\\n    campaign_id,\\n    campaign_name,\\n    ad_group_id,\\n    ad_group_name,\\n    ad_id,\\n    ad_name,\\n    ad_status,\\n    account_id,\\n    currency,\\n    spend,\\n    impressions,\\n    clicks,\\n    -- Business Metrics\\n    CASE WHEN impressions > 0 THEN CAST(clicks AS DOUBLE) / impressions ELSE 0 END AS ctr,\\n    CASE WHEN clicks > 0 THEN spend / clicks ELSE 0 END AS cpc,\\n    CASE WHEN impressions > 0 THEN (spend / impressions) * 1000 ELSE 0 END AS cpm\\