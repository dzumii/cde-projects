{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"dbt_databricks_version\": \"1.12.7\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"9e2cd9e6-0c4a-4ac4-96f8-6a35a9e4d254\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"9e2cd9e6-0c4a-4ac4-96f8-6a35a9e4d254\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n  select\n    elementary_test_results_id,\n    result_row\n  from `marketing_dev`.`staging`.`test_result_rows`\n  where \n        \n        datediff(\n\n    coalesce(date(\n    current_timestamp::timestamp\n), nvl2(date(\n    current_timestamp::timestamp\n), assert_true(date(\n    current_timestamp::timestamp\n) is not null), null))\n\n, \n\n    coalesce(date(cast(detected_at as timestamp)), nvl2(date(cast(detected_at as timestamp)), assert_true(date(cast(detected_at as timestamp)) is not null), null))\n\n) < 7\n  \n    and elementary_test_results_id in (\n        select distinct id\n        from `ordered_test_results__tmp_20261012224051374469`\n        where invocations_rank_index = 1\n    )\n  \n  \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "9e2cd9e6-0c4a-4ac4-96f8-6a35a9e4d254", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"dbt_databricks_version\": \"1.12.7\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"9e2cd9e6-0c4a-4ac4-96f8-6a35a9e4d254\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocat